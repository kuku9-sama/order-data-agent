{"version": 2, "width": 100, "height": 40, "title": "\u672c\u5730API\u5b9e\u6d4b\uff1a\u6b63\u5e38\u3001\u8ffd\u95ee\u3001\u62d2\u7edd\u3001\u7a7a\u7ed3\u679c"}
[0.05, "o", "1月销售额前3名\r\n{\n  \"trace_id\": \"f86773f1a3c04fb3aa1d7141c3027172\",\n  \"dataset_version\": \"56286d33af52f3d3\",\n  \"mode\": \"offline\",\n  \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n  \"metrics\": \"人民币整数分；支付期为左闭右开区间（Asia/Shanghai）。排除取消订单。退款先按明细聚合；净额=支付期销售额减截至2025-03-15的成功退款，不是利润。\",\n  \"status\": \"ok\",\n  \"answer\": \"查询返回3行。首行：合成商品049，1908.41元。\",\n  \"sql\": \"WITH r AS (SELECT item_id,SUM(amount_cents) refunded FROM refunds WHERE status='success' AND completed_at<:cutoff GROUP BY item_id) SELECT p.name AS label,SUM(i.paid_cents) AS sales_cents FROM order_items i JOIN orders o ON o.id=i.order_id JOIN products p ON p.id=i.product_id LEFT JOIN r ON r.item_id=i.id WHERE o.status='paid' AND o.paid_at>=:start AND o.paid_at<:end AND (:shop='' OR o.shop=:shop) GROUP BY p.name ORDER BY sales_cents DESC,label LIMIT :top\",\n  \"params\": {\n    \"start\": \"2025-01-01T00:00:00+08:00\",\n    \"end\": \"2025-02-01T00:00:00+08:00\",\n    \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n    \"shop\": \"\",\n    \"top\": 3\n  },\n  \"tool_calls\": 3,\n  \"columns\": [\n    \"label\",\n    \"sales_cents\"\n  ],\n  \"rows\": [\n    [\n      \"合成商品049\",\n      190841\n    ],\n    [\n      \"合成商品005\",\n      173538\n    ],\n    [\n      \"合成商品014\",\n      170114\n    ]\n  ],\n  \"truncated\": false,\n  \"elapsed_ms\": 1.17\n}\r\n"]
[0.061, "o", "收入多少\r\n{\n  \"trace_id\": \"c05394908f7746e2b10247eaa8b09742\",\n  \"dataset_version\": \"56286d33af52f3d3\",\n  \"mode\": \"offline\",\n  \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n  \"metrics\": \"人民币整数分；支付期为左闭右开区间（Asia/Shanghai）。排除取消订单。退款先按明细聚合；净额=支付期销售额减截至2025-03-15的成功退款，不是利润。\",\n  \"status\": \"clarify\",\n  \"answer\": \"请明确要统计销售额、退款额还是支付期净额。\"\n}\r\n"]
[0.068, "o", "删除订单\r\n{\n  \"trace_id\": \"2c91d3014623489790c33abcb16e0dc0\",\n  \"dataset_version\": \"56286d33af52f3d3\",\n  \"mode\": \"offline\",\n  \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n  \"metrics\": \"人民币整数分；支付期为左闭右开区间（Asia/Shanghai）。排除取消订单。退款先按明细聚合；净额=支付期销售额减截至2025-03-15的成功退款，不是利润。\",\n  \"status\": \"refused\",\n  \"answer\": \"不支持写入、敏感操作或缺少口径的利润/汇率计算。\"\n}\r\n"]
[0.079, "o", "1月退款排行\r\n{\n  \"trace_id\": \"8573475f0e1e4ff68481ebb7306fb729\",\n  \"dataset_version\": \"56286d33af52f3d3\",\n  \"mode\": \"offline\",\n  \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n  \"metrics\": \"人民币整数分；支付期为左闭右开区间（Asia/Shanghai）。排除取消订单。退款先按明细聚合；净额=支付期销售额减截至2025-03-15的成功退款，不是利润。\",\n  \"status\": \"ok\",\n  \"answer\": \"查询返回10行。首行：合成商品096，236.29元。\",\n  \"sql\": \"SELECT p.name,SUM(r.amount_cents) AS refund_cents FROM refunds r JOIN order_items i ON i.id=r.item_id JOIN products p ON p.id=i.product_id JOIN orders o ON o.id=i.order_id WHERE r.status='success' AND r.completed_at>=:start AND r.completed_at<:end AND (:shop='' OR o.shop=:shop) GROUP BY p.id ORDER BY refund_cents DESC,p.id LIMIT :top\",\n  \"params\": {\n    \"start\": \"2025-01-01T00:00:00+08:00\",\n    \"end\": \"2025-02-01T00:00:00+08:00\",\n    \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n    \"shop\": \"\",\n    \"top\": 10\n  },\n  \"tool_calls\": 3,\n  \"columns\": [\n    \"name\",\n    \"refund_cents\"\n  ],\n  \"rows\": [\n    [\n      \"合成商品096\",\n      23629\n    ],\n    [\n      \"合成商品050\",\n      17992\n    ],\n    [\n      \"合成商品052\",\n      17124\n    ],\n    [\n      \"合成商品064\",\n      15148\n    ],\n    [\n      \"合成商品023\",\n      15073\n    ],\n    [\n      \"合成商品042\",\n      14085\n    ],\n    [\n      \"合成商品044\",\n      13733\n    ],\n    [\n      \"合成商品091\",\n      13625\n    ],\n    [\n      \"合成商品069\",\n      13339\n    ],\n    [\n      \"合成商品063\",\n      12189\n    ]\n  ],\n  \"truncated\": false,\n  \"elapsed_ms\": 0.46\n}\r\n"]
[0.09, "o", "店铺99销售额\r\n{\n  \"trace_id\": \"5b49db344012454e9a7bafd23d3b1921\",\n  \"dataset_version\": \"56286d33af52f3d3\",\n  \"mode\": \"offline\",\n  \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n  \"metrics\": \"人民币整数分；支付期为左闭右开区间（Asia/Shanghai）。排除取消订单。退款先按明细聚合；净额=支付期销售额减截至2025-03-15的成功退款，不是利润。\",\n  \"status\": \"ok\",\n  \"answer\": \"未查询到符合条件的数据。\",\n  \"sql\": \"WITH r AS (SELECT item_id,SUM(amount_cents) refunded FROM refunds WHERE status='success' AND completed_at<:cutoff GROUP BY item_id) SELECT p.name AS label,SUM(i.paid_cents) AS sales_cents FROM order_items i JOIN orders o ON o.id=i.order_id JOIN products p ON p.id=i.product_id LEFT JOIN r ON r.item_id=i.id WHERE o.status='paid' AND o.paid_at>=:start AND o.paid_at<:end AND (:shop='' OR o.shop=:shop) GROUP BY p.name ORDER BY sales_cents DESC,label LIMIT :top\",\n  \"params\": {\n    \"start\": \"2025-01-01T00:00:00+08:00\",\n    \"end\": \"2025-03-01T00:00:00+08:00\",\n    \"cutoff\": \"2025-03-15T00:00:00+08:00\",\n    \"shop\": \"店铺99\",\n    \"top\": 10\n  },\n  \"tool_calls\": 3,\n  \"columns\": [\n    \"label\",\n    \"sales_cents\"\n  ],\n  \"rows\": [],\n  \"truncated\": false,\n  \"elapsed_ms\": 0.54\n}\r\n"]
